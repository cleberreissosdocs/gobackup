POSTGRES_PASSWORD=troque-esta-senha
# A conexão com o Central agora é configurada pela própria interface web
# (tela "Configurações", depois do login) — não precisa mais definir a URL
# do Central aqui.
AGENT_WEB_PORT=8081
HEARTBEAT_INTERVAL=1s
# Host directory exposed at /backups inside the containers — point your
# real source/destination directories here (or bind-mount more with extra
# volumes if you need several separate paths).
BACKUP_SOURCE_DIR=./backups
# Host directory with SSH private keys for -dest-type=ssh backups.
SSH_KEY_DIR=./ssh-keys
