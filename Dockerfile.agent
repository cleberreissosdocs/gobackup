# Multi-stage build for gobackup-agent.
# Runtime image includes the tools the agent shells out to:
# rsync (file backups), openssh-client (ssh destinations / known_hosts),
# postgresql-client (pg_dump/pg_dumpall), mariadb-client (mysqldump, works
# for both MySQL and MariaDB), sqlite (sqlite3 CLI, optional .backup mode).

FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /out/gobackup-agent ./cmd/agent

FROM alpine:3.20
RUN apk add --no-cache \
      rsync \
      openssh-client \
      postgresql16-client \
      mariadb-client \
      sqlite \
      ca-certificates \
      tzdata \
      tini
COPY --from=build /out/gobackup-agent /usr/local/bin/gobackup-agent
WORKDIR /data
# tini as PID 1 (not gobackup-agent directly): a cancelled file-mirror job
# kills rsync's whole process group (it forks internal sender/receiver
# children even for a purely local copy), which re-parents any surviving
# child to PID 1 -- without a real init there to reap it, it's left as a
# permanent zombie. tini handles SIGCHLD/wait() for orphans correctly, the
# way a container's PID 1 is supposed to.
ENTRYPOINT ["tini", "--", "gobackup-agent"]
CMD ["--help"]
